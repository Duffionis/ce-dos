usa "dos.ce";
usa "@file.ce";
usa "@testo.ce";
usa "@risultato.ce";

funzione principale() -> intero {
    se numero_argomenti() < 2 { stampa("uso: ce-dos programma.com"); ritorna 2; }
    costante lett: Risultato<[byte], testo> = leggi_file(argomento(1));
    se !lett.riuscito { stampa("errore: ", lett.errore); ritorna 2; }
    costante d: [byte] = lett.valore;
    se d.lunghezza > 1 && d[0] == 77 && d[1] == 90 {
        se !carica_exe(d) { stampa("EXE non valido"); ritorna 2; }
    } altrimenti {
        carica_com(d);
    }
    variabile ppm: testo = "";
    variabile i: dimensione = 2;
    mentre i < numero_argomenti() {
        costante a: testo = argomento(i);
        se testo_uguale(a, "--schermo") { schermo_attivo = vero; pulisci_schermo(); }
        altrimenti se testo_uguale(a, "--ppm") && i + 1 < numero_argomenti() { ppm = argomento(i + 1); i += 1; }
        i += 1;
    }
    inizializza_dac();
    variabile in_vivo: booleano = falso;
    i = 2;
    mentre i < numero_argomenti() { se testo_uguale(argomento(i), "--vivo") { in_vivo = vero; } i += 1; }
    se in_vivo { pulisci_schermo(); esegui_vivo(); ritorna codice_uscita come intero; }
    esegui(2000000000);
    se schermo_attivo && modo_video != 19 { mostra_schermo(); }
    se ppm.lunghezza > 0 { scrivi_ppm(ppm); }
    ritorna codice_uscita come intero;
}
