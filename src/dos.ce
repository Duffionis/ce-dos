// Servizi DOS/BIOS "alla DOSBox": invece di caricare un vero DOS, le interruzioni
// vengono intercettate e servite dal programma ospite.
usa "cpu86.ce";
usa "@file.ce";
usa "@testo.ce";

esterna funzione putchar(c: intero) -> intero;
esterna funzione getchar() -> intero;
esterna funzione fflush(f: *byte) -> intero;
esterna funzione system(c: *byte) -> intero;
esterna funzione read(fd: intero, buf: *byte, n: dimensione) -> lungo;
esterna funzione usleep(us: naturale32) -> intero;
esterna funzione fgetc(f: *byte) -> intero;
esterna funzione fputc(c: intero, f: *byte) -> intero;
esterna funzione remove(percorso: *byte) -> intero;

variabile uscita: booleano;
variabile codice_uscita: byte;
variabile dta: naturale16 = 128;
variabile seg_psp: naturale16 = 4096;
variabile aperti: [*byte; 20];

funzione non_valido(f: *byte) -> booleano {
    rischio { ritorna f == ((0 come dimensione) come *byte); }
}

// il percorso ASCIIZ in DS:DX come stringa C
funzione percorso_dos() -> [byte] {
    variabile m: [byte] = riserva(byte, 130);
    variabile i: dimensione = 0;
    mentre i < 128 {
        costante c: byte = leggi8(sg[DS], r[DX] + (i come naturale16));
        m[i] = c;
        se c == 0 { ritorna m; }
        i += 1;
    }
    m[128] = 0;
    ritorna m;
}

funzione errore_dos(codice: naturale16) { r[AX] = codice; imposta(F_CF, vero); }

funzione apri_dos(modo: testo) {
    variabile p: [byte] = percorso_dos();
    variabile m: [byte] = testo_c(modo);
    variabile f: *byte;
    rischio { f = fopen(&p[0], &m[0]); libera(p); libera(m); }
    se non_valido(f) { errore_dos(2); ritorna; }
    variabile i: dimensione = 0;
    mentre i < 20 {
        se non_valido(aperti[i]) { aperti[i] = f; r[AX] = (i come naturale16) + 5; imposta(F_CF, falso); ritorna; }
        i += 1;
    }
    rischio { fclose(f); }
    errore_dos(4);
}

funzione maniglia() -> *byte {
    variabile nulla: *byte;
    rischio { nulla = (0 come dimensione) come *byte; }
    se r[BX] < 5 || r[BX] >= 25 { ritorna nulla; }
    ritorna aperti[(r[BX] - 5) come dimensione];
}

funzione servizio_file(f: byte) {
    imposta(F_CF, falso);
    scegli f {
        caso 60 { apri_dos("w+b"); }
        caso 61 { se (al() & 3) == 0 { apri_dos("rb"); } altrimenti { apri_dos("r+b"); } }
        caso 62 {
            costante h: *byte = maniglia();
            se non_valido(h) { errore_dos(6); ritorna; }
            rischio { fclose(h); }
            variabile nulla: *byte;
            rischio { nulla = (0 come dimensione) come *byte; }
            aperti[(r[BX] - 5) come dimensione] = nulla;
        }
        caso 63 {
            costante h: *byte = maniglia();
            se non_valido(h) { errore_dos(6); ritorna; }
            variabile n: naturale16 = 0;
            mentre n < r[CX] {
                variabile c: intero = 0;
                rischio { c = fgetc(h); }
                se c < 0 { r[CX] = n; }
                altrimenti { scrivi8(sg[DS], r[DX] + n, c come byte); n = n + 1; }
            }
            r[AX] = n;
        }
        caso 64 {
            costante h: *byte = maniglia();
            se non_valido(h) { errore_dos(6); ritorna; }
            variabile n: naturale16 = 0;
            mentre n < r[CX] {
                rischio { fputc(leggi8(sg[DS], r[DX] + n) come intero, h); }
                n = n + 1;
            }
            r[AX] = n;
        }
        caso 65 {
            variabile p: [byte] = percorso_dos();
            variabile e: intero = 0;
            rischio { e = remove(&p[0]); libera(p); }
            se e != 0 { errore_dos(2); }
        }
        caso 66 {
            costante h: *byte = maniglia();
            se non_valido(h) { errore_dos(6); ritorna; }
            costante spo: lungo = ((r[CX] come lungo) << 16) | (r[DX] come lungo);
            variabile pos: lungo = 0;
            rischio {
                fseek(h, spo, al() come intero);
                pos = ftell(h);
            }
            r[AX] = (pos & 65535) come naturale16;
            r[DX] = ((pos >> 16) & 65535) come naturale16;
        }
        altrimenti { errore_dos(1); }
    }
}

variabile modo_video: byte = 3;
variabile col: naturale16;
variabile riga: naturale16;
variabile schermo_attivo: booleano;
variabile attributo: byte = 7;

funzione inizializza_dac() {
    costante cga: [naturale32; 48] = [0, 0, 0, 0, 0, 42, 0, 42, 0, 0, 42, 42, 42, 0, 0, 42, 0, 42, 42, 21, 0, 42, 42, 42, 21, 21, 21, 21, 21, 63, 21, 63, 21, 21, 63, 63, 63, 21, 21, 63, 21, 63, 63, 63, 21, 63, 63, 63];
    variabile i: dimensione = 0;
    mentre i < 256 {
        se i < 16 {
            dac[i * 3] = cga[i * 3] come byte; dac[i * 3 + 1] = cga[i * 3 + 1] come byte; dac[i * 3 + 2] = cga[i * 3 + 2] come byte;
        } altrimenti se i < 32 {
            costante g: naturale32 = (((i - 16) come naturale32) * 63) / 15;
            dac[i * 3] = g come byte; dac[i * 3 + 1] = g come byte; dac[i * 3 + 2] = g come byte;
        } altrimenti se i < 248 {
            costante j: naturale32 = (i - 32) come naturale32;
            dac[i * 3] = ((((j / 36) % 6) * 63) / 5) come byte;
            dac[i * 3 + 1] = ((((j / 6) % 6) * 63) / 5) come byte;
            dac[i * 3 + 2] = (((j % 6) * 63) / 5) come byte;
        }
        i += 1;
    }
}

funzione cella(c: naturale16, y: naturale16) -> naturale16 { ritorna (y * 80 + c) * 2; }

funzione pulisci_schermo() {
    variabile i: naturale16 = 0;
    mentre i < 2000 { scrivi8(47104, i * 2, 32); scrivi8(47104, i * 2 + 1, 7); i += 1; }
    col = 0; riga = 0;
}

funzione scorri_su() {
    variabile i: naturale16 = 0;
    mentre i < 1920 { scrivi16(47104, i * 2, leggi16(47104, i * 2 + 160)); i += 1; }
    mentre i < 2000 { scrivi16(47104, i * 2, 1824); i += 1; }
}

funzione a_capo() {
    col = 0; riga += 1;
    se riga >= 25 { scorri_su(); riga = 24; }
}

funzione emetti(c: byte) {
    se !schermo_attivo { rischio { putchar(c come intero); } ritorna; }
    scegli c {
        caso 13 { col = 0; }
        caso 10 { a_capo(); }
        caso 8 { se col > 0 { col -= 1; } }
        caso 7 { }
        altrimenti {
            scrivi8(47104, cella(col, riga), c);
            scrivi8(47104, cella(col, riga) + 1, attributo);
            col += 1;
            se col >= 80 { a_capo(); }
        }
    }
}

funzione mostra_schermo() {
    variabile y: naturale16 = 0;
    mentre y < 25 {
        variabile fine: naturale16 = 80;
        mentre fine > 0 && leggi8(47104, cella(fine - 1, y)) <= 32 { fine -= 1; }
        variabile c: naturale16 = 0;
        mentre c < fine {
            variabile b: byte = leggi8(47104, cella(c, y));
            se b < 32 { b = 32; }
            rischio { putchar(b come intero); }
            c += 1;
        }
        rischio { putchar(10); }
        y += 1;
    }
}

funzione scrivi_ppm(percorso: testo) {
    costante f: *byte = apri_file(percorso, "wb");
    se non_valido(f) { ritorna; }
    rischio { fputc(80, f); fputc(54, f); fputc(10, f); }
    variabile intest: [byte] = riserva(byte, 16);
    rischio { libera(intest); }
    costante t: testo = "320 200\n255\n";
    variabile k: dimensione = 0;
    mentre k < t.lunghezza { rischio { fputc(t[k] come intero, f); } k += 1; }
    variabile i: naturale16 = 0;
    mentre i < 64000 {
        costante idx: dimensione = leggi8(40960, i) come dimensione;
        variabile q: dimensione = 0;
        mentre q < 3 {
            costante v: naturale32 = (dac[idx * 3 + q] come naturale32) * 255 / 63;
            rischio { fputc(v come intero, f); }
            q += 1;
        }
        i += 1;
    }
    rischio { fclose(f); }
}

funzione al() -> byte { ritorna reg8(0); }
funzione ah() -> byte { ritorna reg8(4); }

variabile vivo: booleano;          // tastiera "viva": nessun blocco, il programma ospite continua a girare
variabile tasto_buf: intero = -1;
variabile manca: booleano;         // un servizio bloccante non ha trovato tasti
variabile attesa: booleano;        // l'ultima istruzione e' stata rimandata: aspettare
variabile linea_attiva: booleano;
variabile linea_n: naturale16;

// legge i tasti premuti (terminale non bloccante)
funzione sonda_tasti() {
    se tasto_buf >= 0 { ritorna; }
    variabile b: [byte; 1];
    variabile n: lungo = 0;
    rischio { n = read(0, &b[0], 1); }
    se n == 1 {
        se b[0] == 10 { tasto_buf = 13; } altrimenti { tasto_buf = b[0] come intero; }
    }
}

// legge un carattere dalla tastiera (stdin); 0 se finito
funzione leggi_tasto() -> byte {
    se vivo {
        se tasto_buf < 0 { sonda_tasti(); }
        se tasto_buf < 0 { manca = vero; ritorna 0; }
        costante t: byte = tasto_buf come byte;
        tasto_buf = -1;
        ritorna t;
    }
    variabile c: intero = 0;
    rischio { c = getchar(); }
    se c < 0 { ritorna 26; }
    ritorna c come byte;
}

// il servizio non ha ottenuto il tasto: rieseguire l'INT piu' tardi
funzione rimanda_int() {
    manca = falso; attesa = vero;
    ip = ip - 2;
}

funzione servizio_dos() {
    costante f: byte = ah();
    scegli f {
        caso 0 { uscita = vero; }
        caso 1 {
            costante c: byte = leggi_tasto();
            se manca { rimanda_int(); ritorna; }
            emetti(c); imposta_reg8(0, c);
        }
        caso 2 { emetti(reg8(2)); }
        caso 6 {
            se reg8(2) != 255 { emetti(reg8(2)); } altrimenti { imposta_reg8(0, 0); imposta(F_ZF, vero); }
        }
        caso 7, 8 {
            costante c: byte = leggi_tasto();
            se manca { rimanda_int(); ritorna; }
            imposta_reg8(0, c);
        }
        caso 9 {
            variabile o: naturale16 = r[DX];
            mentre leggi8(sg[DS], o) != 36 { emetti(leggi8(sg[DS], o)); o = o + 1; }
        }
        caso 10 {
            // lettura con buffer: [max][letti][dati...]
            costante base: naturale16 = r[DX];
            costante massimo: naturale16 = leggi8(sg[DS], base) come naturale16;
            se !linea_attiva { linea_n = 0; linea_attiva = vero; }
            variabile n: naturale16 = linea_n;
            variabile fine: booleano = falso;
            mentre !fine {
                costante c: byte = leggi_tasto();
                se manca { linea_n = n; rimanda_int(); ritorna; }
                se c == 10 || c == 13 || c == 26 { fine = vero; }
                altrimenti se c == 8 { se n > 0 { n = n - 1; se vivo { emetti(8); emetti(32); emetti(8); } } }
                altrimenti se n + 1 < massimo { scrivi8(sg[DS], base + 2 + n, c); n = n + 1; se vivo { emetti(c); } }
            }
            linea_attiva = falso;
            se vivo { emetti(13); emetti(10); }
            scrivi8(sg[DS], base + 1, n come byte);
            scrivi8(sg[DS], base + 2 + n, 13);
        }
        caso 11 {
            se vivo { sonda_tasti(); }
            se tasto_buf >= 0 { imposta_reg8(0, 255); } altrimenti { imposta_reg8(0, 0); }
        }
        caso 12 { imposta_reg8(0, 0); }
        caso 14 { imposta_reg8(0, 26); }
        caso 25 { imposta_reg8(0, 2); }
        caso 26 { dta = r[DX]; }
        caso 37 {
            costante n: naturale16 = reg8(0) come naturale16;
            scrivi16(0, n * 4, r[DX]); scrivi16(0, n * 4 + 2, sg[DS]);
        }
        caso 48 { r[AX] = 5; }   // DOS 5.0
        caso 53 {
            costante n: naturale16 = reg8(0) come naturale16;
            r[BX] = leggi16(0, n * 4); sg[ES] = leggi16(0, n * 4 + 2);
        }
        caso 44 { r[CX] = 0; r[DX] = 0; }   // ora
        caso 42 { r[CX] = 2026; r[DX] = 1024; imposta_reg8(0, 6); }
        caso 60, 61, 62, 63, 65, 66 { servizio_file(f); }
        caso 64 {
            // scrittura: schermo (1, 2) oppure file
            se r[BX] != 1 && r[BX] != 2 { servizio_file(f); }
            altrimenti se r[BX] == 1 || r[BX] == 2 {
                variabile i: naturale16 = 0;
                mentre i < r[CX] { emetti(leggi8(sg[DS], r[DX] + i)); i = i + 1; }
                r[AX] = r[CX];
                imposta(F_CF, falso);
            }
        }
        caso 76 { codice_uscita = al(); uscita = vero; }
        altrimenti { imposta(F_CF, vero); r[AX] = 1; }
    }
}

funzione servizio_video() {
    scegli ah() {
        caso 0 {
            modo_video = al() & 127;
            se modo_video == 3 || modo_video == 2 { pulisci_schermo(); }
            se modo_video == 19 {
                variabile i: naturale32 = 0;
                mentre i < 64000 { scrivi8(40960, i come naturale16, 0); i += 1; }
            }
        }
        caso 2 { riga = reg8(6) come naturale16; col = reg8(2) come naturale16; }
        caso 3 { imposta_reg8(6, riga come byte); imposta_reg8(2, col come byte); r[CX] = 1543; }
        caso 6 {
            costante n: naturale16 = reg8(0) come naturale16;
            variabile y: naturale16 = reg8(5) come naturale16;
            mentre y <= (reg8(6) come naturale16) {
                variabile x: naturale16 = reg8(1) come naturale16;
                mentre x <= (reg8(2) come naturale16) {
                    se n == 0 || y + n > (reg8(6) come naturale16) {
                        scrivi8(47104, cella(x, y), 32); scrivi8(47104, cella(x, y) + 1, reg8(7));
                    } altrimenti {
                        scrivi16(47104, cella(x, y), leggi16(47104, cella(x, y + n)));
                    }
                    x += 1;
                }
                y += 1;
            }
        }
        caso 9, 10 {
            variabile n: naturale16 = 0;
            mentre n < r[CX] && col + n < 80 {
                scrivi8(47104, cella(col + n, riga), al());
                se ah() == 9 { scrivi8(47104, cella(col + n, riga) + 1, reg8(3)); }
                n += 1;
            }
        }
        caso 14 { emetti(al()); }
        caso 15 { r[AX] = 80 * 256 + (modo_video come naturale16); imposta_reg8(7, 0); }
        altrimenti { }
    }
}

funzione servizio_tastiera() {
    scegli ah() {
        caso 0, 16 {
            costante c: byte = leggi_tasto();
            se manca { rimanda_int(); ritorna; }
            r[AX] = c come naturale16;
        }
        caso 1, 17 {
            se vivo { sonda_tasti(); }
            se tasto_buf >= 0 { imposta(F_ZF, falso); r[AX] = tasto_buf come naturale16; } altrimenti { imposta(F_ZF, vero); }
        }
        altrimenti { }
    }
}

// vero se l'interruzione e' stata servita dall'ospite
funzione intercetta(n: byte) -> booleano {
    scegli n {
        caso 32 { uscita = vero; ritorna vero; }
        caso 33 { servizio_dos(); ritorna vero; }
        caso 16 { servizio_video(); ritorna vero; }
        caso 22 { servizio_tastiera(); ritorna vero; }
        caso 26 { r[CX] = 0; r[DX] = 0; imposta_reg8(0, 0); ritorna vero; }
        altrimenti { ritorna falso; }
    }
}

// .EXE (MZ): ritorna falso se l'intestazione non e' valida
funzione carica_exe(d: [byte]) -> booleano {
    se d.lunghezza < 28 { ritorna falso; }
    ritorna carica_exe_dati(d);
}

funzione parola_exe(d: [byte], o: dimensione) -> naturale16 {
    ritorna (d[o] come naturale16) | ((d[o + 1] come naturale16) << 8);
}

funzione carica_exe_dati(d: [byte]) -> booleano {
    costante ultima: naturale32 = parola_exe(d, 2) come naturale32;
    costante pagine: naturale32 = parola_exe(d, 4) come naturale32;
    costante nrilo: dimensione = parola_exe(d, 6) come dimensione;
    costante testata: naturale32 = (parola_exe(d, 8) come naturale32) * 16;
    costante tab: dimensione = parola_exe(d, 24) come dimensione;
    variabile fine: naturale32 = pagine * 512;
    se ultima != 0 { fine = (pagine - 1) * 512 + ultima; }
    se fine > (d.lunghezza come naturale32) { fine = d.lunghezza come naturale32; }
    costante inizio: naturale16 = seg_psp + 16;
    scrivi8(seg_psp, 0, 205); scrivi8(seg_psp, 1, 32);
    variabile i: naturale32 = testata;
    mentre i < fine {
        scrivi8(inizio, ((i - testata) & 65535) come naturale16, d[i come dimensione]);
        // i moduli piu' grandi di 64K cambiano segmento
        i += 1;
    }
    variabile k: dimensione = 0;
    mentre k < nrilo {
        costante o: dimensione = tab + k * 4;
        costante off: naturale16 = parola_exe(d, o);
        costante sgm: naturale16 = parola_exe(d, o + 2);
        costante v: naturale16 = leggi16(inizio + sgm, off);
        scrivi16(inizio + sgm, off, v + inizio);
        k += 1;
    }
    sg[ES] = seg_psp; sg[DS] = seg_psp;
    sg[SS] = inizio + parola_exe(d, 14);
    r[SP] = parola_exe(d, 16);
    ip = parola_exe(d, 20);
    sg[CS] = inizio + parola_exe(d, 22);
    flag = 514;
    ritorna vero;
}

funzione carica_com(d: [byte]) {
    sg[CS] = seg_psp; sg[DS] = seg_psp; sg[ES] = seg_psp; sg[SS] = seg_psp;
    scrivi8(seg_psp, 0, 205); scrivi8(seg_psp, 1, 32);     // INT 20h
    variabile i: dimensione = 0;
    mentre i < d.lunghezza { scrivi8(seg_psp, 256 + (i come naturale16), d[i]); i += 1; }
    ip = 256; r[SP] = 65534; scrivi16(seg_psp, 65534, 0);
    flag = 514;
}

funzione esegui(massimo: naturale64) -> naturale64 {
    variabile n: naturale64 = 0;
    attesa = falso;
    mentre !uscita && !fermo && n < massimo && !attesa {
        passo();
        se int_sospesa >= 0 {
            costante v: byte = int_sospesa come byte;
            se intercetta(v) { int_sospesa = -1; } altrimenti { servi_int(); }
        }
        n += 1;
    }
    ritorna n;
}

// ---------- terminale vivo ----------
variabile ultimo_controllo: naturale32;

funzione disegna_terminale(forza: booleano) {
    variabile somma: naturale32 = 0;
    variabile i: naturale16 = 0;
    mentre i < 4000 { somma = somma * 31 + (leggi8(47104, i) come naturale32); i += 1; }
    somma = somma + (riga * 100 + col) come naturale32;
    se somma == ultimo_controllo && !forza { ritorna; }
    ultimo_controllo = somma;
    rischio { putchar(27); putchar(91); putchar(72); }
    variabile y: naturale16 = 0;
    mentre y < 25 {
        variabile x: naturale16 = 0;
        mentre x < 80 {
            variabile b: byte = leggi8(47104, cella(x, y));
            se b < 32 { b = 32; }
            rischio { putchar(b come intero); }
            x += 1;
        }
        rischio { putchar(10); }
        y += 1;
    }
    // cursore
    rischio {
        putchar(27); putchar(91);
        variabile s: Stringa = nuova_stringa();
        aggiungi_numero(s, (riga + 1) come lungo); aggiungi_byte(s, 59); aggiungi_numero(s, (col + 1) come lungo); aggiungi_byte(s, 72);
        variabile k: dimensione = 0;
        costante t: testo = come_testo(s);
        mentre k < t.lunghezza { putchar(t[k] come intero); k += 1; }
        libera_stringa(s);
    }
}

funzione esegui_vivo() {
    rischio { system(&comando_raw()[0]); putchar(27); putchar(91); putchar(50); putchar(74); }
    vivo = vero; schermo_attivo = vero;
    mentre !uscita && !fermo {
        sonda_tasti();
        se tasto_buf == 29 { uscita = vero; }
        altrimenti {
            esegui(40000);
            disegna_terminale(falso);
            se attesa { rischio { usleep(15000); } }
        }
    }
    disegna_terminale(vero);
    rischio { system(&comando_sano()[0]); putchar(10); }
}

funzione comando_raw() -> [byte] { ritorna testo_c("stty -icanon -echo -isig min 0 time 0"); }
funzione comando_sano() -> [byte] { ritorna testo_c("stty sane"); }
